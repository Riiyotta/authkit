{
  "id": "component.section-header",
  "name": "SectionHeader",
  "className": ".section-header",
  "purpose": "Give every product-demo and conversion section the same three-part opening (eyebrow / multi-line title / description) so the page reads as one document.",
  "tags": [
    "header",
    "shared"
  ],
  "composes": [
    "primitive.eyebrow"
  ],
  "props": {
    "eyebrow": {
      "type": "string",
      "maxWords": 3
    },
    "title": {
      "type": "array",
      "itemType": "string",
      "note": "An ARRAY of line strings, each rendered as its own <span>. Line breaks are authored, not reflowed."
    },
    "titleMobile": {
      "type": "array",
      "itemType": "string",
      "note": "An art-directed alternate line split. Only ONE section ships this (demo.radix); the switch is at max-width:1200px."
    },
    "titleClass": {
      "type": "string",
      "enum": [
        "section-header-title-h2",
        "section-header-title-h3",
        "section-header-title-h6"
      ],
      "default": "section-header-title-h3"
    },
    "titleTag": {
      "type": "string",
      "enum": [
        "h2",
        "h3",
        "h6"
      ],
      "default": "h3"
    },
    "description": {
      "type": "string",
      "maxWords": 22
    }
  },
  "copyBudget": {
